# Leave empty when the client is served behind the same reverse proxy as the API.
VITE_API_URL=
# Development-only Vite proxy target.
VITE_DEV_API_PROXY=http://localhost:5000

# Must match server CSRF_COOKIE_NAME.
VITE_CSRF_COOKIE_NAME=teamhub.csrf

# Dedicated Vahlay Assessment Portal URL
VITE_ASSESSMENT_PORTAL_URL=http://localhost:5174
